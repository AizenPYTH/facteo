{
  "expo": {
    "name": "INVEQ",
    "slug": "FACTEO",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inveq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.inveq.app",
      "buildNumber": "58",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.inveq.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "INVEQ a besoin d’accéder à vos photos pour importer le logo et la signature.",
          "cameraPermission": "INVEQ a besoin d’accéder à l’appareil photo pour importer le logo et la signature."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "INVEQ utilise l’appareil photo pour scanner le QR code de connexion et analyser vos produits.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4F46E5",
          "sounds": []
        }
      ],
      "expo-iap",
      "./plugins/with-defer-iap-launch.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55dde7c8-8d60-4b90-a665-53d800d2aa22"
      }
    }
  }
}
