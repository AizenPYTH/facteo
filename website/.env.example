NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Recherche entreprise (API publique française — même service que l'app mobile)
NEXT_PUBLIC_COMPANY_SEARCH_API_URL=https://recherche-entreprises.api.gouv.fr
NEXT_PUBLIC_COMPANY_SEARCH_PROVIDER=recherche-entreprises

# Accès mobile web : false = pages iOS/Android dédiées, true = site web autorisé sur mobile
NEXT_PUBLIC_ENABLE_MOBILE_WEB=false
# App Store (quand publié)
NEXT_PUBLIC_IOS_APP_AVAILABLE=false
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=
