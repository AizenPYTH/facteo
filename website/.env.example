# Local : http://localhost:3000 — Production : https://www.inveq.fr
NEXT_PUBLIC_SITE_URL=https://www.inveq.fr
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Contacts (sans domaine mail : utilise ton Gmail)
NEXT_PUBLIC_CONTACT_EMAIL=farouqdib@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=farouqdib@gmail.com

# Recherche entreprise (API publique française — même service que l'app mobile)
NEXT_PUBLIC_COMPANY_SEARCH_API_URL=https://recherche-entreprises.api.gouv.fr
NEXT_PUBLIC_COMPANY_SEARCH_PROVIDER=recherche-entreprises

# Accès mobile web : false = gate /mobile/* sur routes non exemptes ; `/` n’est jamais redirigée
NEXT_PUBLIC_ENABLE_MOBILE_WEB=false
# App Store — l’app iOS « INVEQ – Factures & Devis » est publiée (id 6794705229, iOS 16.4 min).
# Ces deux variables pilotent le gate /mobile/ios : les définir en production (Vercel)
# pour que les visiteurs iPhone se voient proposer le téléchargement App Store.
NEXT_PUBLIC_IOS_APP_AVAILABLE=true
NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/fr/app/inveq-factures-devis/id6794705229
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=

# --- Google OAuth (config dans Google Cloud + Supabase Dashboard) ---
# Voir website/docs/GOOGLE_OAUTH_SETUP.md pour afficher "INVEQ" (pas le sous-domaine Supabase).
# Authentication → Providers → Google : Client ID + Client Secret Google Cloud
# Redirect URLs à autoriser :
#   http://localhost:3000/auth/callback
#   https://www.inveq.fr/auth/callback
# Site URL : https://www.inveq.fr

# SUPER PDP secrets live in Supabase Edge Function secrets (never NEXT_PUBLIC_*).
# See docs/super-pdp.md

# Stripe Checkout abonnement web : les secrets vivent dans Supabase Edge Functions.
# Price IDs mensuels : stripe_price_id sur subscription_plans, ou STRIPE_BASIQUE_PRICE_ID /
# STRIPE_STANDARD_PRICE_ID / STRIPE_PRO_PRICE_ID. Le site appelle
# stripe-create-subscription-checkout puis revient sur /app/settings/subscription.
