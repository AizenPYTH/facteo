# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Déploiement Vercel (Project Settings > Environment Variables)
# Configurez au minimum EXPO_PUBLIC_SUPABASE_URL et EXPO_PUBLIC_SUPABASE_ANON_KEY
# pour que le build web (npm run build:web) réussisse.

# Stripe Checkout factures (optionnel — dérivé automatiquement de SUPABASE_URL si absent)
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=

# Stripe Checkout abonnement Premium (optionnel — dérivé automatiquement de SUPABASE_URL si absent)
EXPO_PUBLIC_STRIPE_SUBSCRIPTION_CHECKOUT_URL=
EXPO_PUBLIC_STRIPE_SUBSCRIPTION_CONFIRM_URL=

# Secrets Supabase Edge Functions (Dashboard > Edge Functions > Secrets)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...   # requis tant que subscription_plans.stripe_price_id est vide
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # webhook paiement factures
# FACTEO_SUBSCRIPTION_RETURN_URL=facteo://settings/premium  # fallback si l'app n'envoie pas returnUrl
#
# Webhook Stripe abonnement (Dashboard Stripe > Webhooks > Ajouter un endpoint) :
# URL : https://<project-ref>.supabase.co/functions/v1/stripe-subscription-webhook
# Événements : checkout.session.completed, customer.subscription.created,
#              customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed

# Recherche entreprise (API publique française — ex. api.gouv.fr)
EXPO_PUBLIC_COMPANY_SEARCH_API_URL=https://recherche-entreprises.api.gouv.fr
EXPO_PUBLIC_COMPANY_SEARCH_PROVIDER=recherche-entreprises

# Mode développeur (bêta uniquement — jamais true en production App Store)
# EXPO_PUBLIC_ENABLE_DEV_TOOLS=true
# EXPO_PUBLIC_APP_ENV=development
