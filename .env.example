# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (production)
# Exemple : https://www.inveq.fr
EXPO_PUBLIC_SITE_URL=https://www.inveq.fr
EXPO_PUBLIC_CONTACT_EMAIL=farouqdib@gmail.com
EXPO_PUBLIC_SUPPORT_EMAIL=farouqdib@gmail.com

# Déploiement Vercel (Project Settings > Environment Variables)
# Configurez au minimum EXPO_PUBLIC_SUPABASE_URL et EXPO_PUBLIC_SUPABASE_ANON_KEY
# pour que le build web (npm run build:web) réussisse.

# Stripe Checkout factures (optionnel — dérivé automatiquement de SUPABASE_URL si absent)
EXPO_PUBLIC_STRIPE_CHECKOUT_URL=

# Stripe Checkout abonnement Premium (optionnel — dérivé automatiquement de SUPABASE_URL si absent)
EXPO_PUBLIC_STRIPE_SUBSCRIPTION_CHECKOUT_URL=
EXPO_PUBLIC_STRIPE_SUBSCRIPTION_CONFIRM_URL=

# Confirmation In-App Purchase Apple (optionnel — dérivé de SUPABASE_URL si absent)
EXPO_PUBLIC_APPLE_SUBSCRIPTION_CONFIRM_URL=

# ---------------------------------------------------------------------------
# SUPER PDP (serveur / Edge Functions UNIQUEMENT — jamais EXPO_PUBLIC_*)
# ---------------------------------------------------------------------------
# SUPER_PDP_CLIENT_ID=
# SUPER_PDP_CLIENT_SECRET=
# SUPER_PDP_REDIRECT_URI=https://<PROJECT_REF>.supabase.co/functions/v1/superpdp-oauth-callback
# SUPER_PDP_API_BASE_URL=https://api.superpdp.tech
# SUPER_PDP_TOKEN_ENCRYPTION_KEY=   # openssl rand -hex 32
# SUPER_PDP_SUCCESS_REDIRECT_URL=https://www.inveq.fr/app/settings/e-invoicing
# SUPER_PDP_WEBHOOK_SHARED_SECRET=  # uniquement après confirmation SUPER PDP du schéma de signature

# Secrets Supabase Edge Functions (Dashboard > Edge Functions > Secrets)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# INVEQ_SUBSCRIPTION_RETURN_URL=INVEQ://settings/premium

# ---------------------------------------------------------------------------
# Envoi des documents par e-mail (Resend)
# ---------------------------------------------------------------------------
# Côté application : rien à renseigner. L'URL de l'Edge Function est dérivée de
# EXPO_PUBLIC_SUPABASE_URL. Ne surchargez que pour pointer un autre projet.
# EXPO_PUBLIC_SEND_DOCUMENT_EMAIL_URL=
#
# Côté serveur (Supabase Dashboard > Edge Functions > Secrets) — JAMAIS EXPO_PUBLIC_* :
# RESEND_API_KEY=re_...              # obligatoire, sinon l'envoi renvoie 503
# RESEND_FROM_ADDRESS=factures@inveq.fr   # optionnel (valeur par défaut)
# RESEND_FROM_NAME=INVEQ                  # optionnel (valeur par défaut)

# Recherche entreprise
EXPO_PUBLIC_COMPANY_SEARCH_API_URL=https://recherche-entreprises.api.gouv.fr
EXPO_PUBLIC_COMPANY_SEARCH_PROVIDER=recherche-entreprises

# EXPO_PUBLIC_APP_ENV=production

# ---------------------------------------------------------------------------
# Intégration eBay (import de commandes) — lecture seule
# ---------------------------------------------------------------------------
# Côté application : RIEN. Aucun identifiant eBay ne doit exister ici.
# L'app n'appelle que les Edge Functions ; elle ne connaît ni le client_id,
# ni le client_secret, ni le RuName, ni aucun jeton.
#
# Côté serveur (Supabase Dashboard > Edge Functions > Secrets) — JAMAIS EXPO_PUBLIC_* :
# EBAY_CLIENT_ID=Votre-App-PRD-...        # App ID du keyset Production
# EBAY_CLIENT_SECRET=PRD-...              # Cert ID du keyset Production
# EBAY_RUNAME=Votre_Nom-VotreApp-PRD-...  # RuName (PAS une URL)
# EBAY_ENVIRONMENT=production             # production | sandbox
# INTEGRATIONS_TOKEN_ENCRYPTION_KEY=      # 32 octets : openssl rand -base64 32
# EBAY_APP_RETURN_URL=inveq://settings/integrations-ebay   # optionnel (défaut)
# EBAY_RETURN_URL=https://www.inveq.fr/app/settings/integrations/ebay  # optionnel
#
# Sandbox (facultatif, identifiants et RuName DISTINCTS de la production) :
# EBAY_SANDBOX_CLIENT_ID=
# EBAY_SANDBOX_CLIENT_SECRET=
# EBAY_SANDBOX_RUNAME=
